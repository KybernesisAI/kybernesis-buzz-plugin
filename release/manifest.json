{
  "id": "kybernesis.agent",
  "name": "Kybernesis",
  "apiVersion": 1,
  "description": "A Kybernesis agent in Buzz, with long-term memory.",
  "discovery": {
    "category": "agents",
    "tags": [
      "Agents",
      "Memory"
    ]
  },
  "host": {
    "commands": [
      {
        "id": "this-mac",
        "program": "sh",
        "args": [
          "-c",
          "/usr/sbin/system_profiler -json SPHardwareDataType 2>/dev/null; echo; echo @@kybernesis@@; /usr/sbin/scutil --get ComputerName 2>/dev/null"
        ]
      }
    ],
    "networkOrigins": [
      "https://buzz.kybernesis.ai",
      "https://mcp.arcana.kybernesis.ai"
    ],
    "files": true,
    "processes": [
      {
        "id": "write-file",
        "program": "sh",
        "args": [
          "-c",
          "mkdir -p \"$(dirname \"$1\")\" && cat > \"$1\"",
          "kybernesis-write"
        ]
      }
    ]
  }
}
